# === ПРОМТАНК — Оптимизация сервера ===

# --- Включение модулей ---
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# === 1. СЖАТИЕ (Gzip/Brotli) ===

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml font/ttf font/otf
    AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
    # Удаляем пробелы из сжатых ответов
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    Header append Vary User-Agent
</IfModule>

# Brotli (если модуль установлен)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
    BrotliCompressionQuality 6
</IfModule>

# === 2. КЕШИРОВАНИЕ ===

# Изображения — долгий кеш (1 год)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|svg|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# CSS/JS — кеш 1 год (меняем имя файла при обновлении)
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HTML — короткий кеш (проверять каждые 30 мин)
<FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=1800, must-revalidate"
</FilesMatch>

# Шрифты
<FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# === 3. WEBP — АВТОМАТИЧЕСКАЯ ВЫДАЧА ===

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Проверяем поддержку WebP браузером
    RewriteCond %{HTTP_ACCEPT} image/webp
    
    # Проверяем, что WebP-версия существует
    RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
    
    # Отдаём WebP вместо JPG/PNG (без редиректа, прозрачно)
    RewriteRule ^(.+)\.(jpg|jpeg|png)$ $1.webp [T=image/webp,E=webp:1]
    
    # Добавляем Vary заголовок для корректной работы кеша
    Header always append Vary Accept env=REDIRECT_webp
</IfModule>

# === 4. БЕЗОПАСНОСТЬ ===

# Запрещаем доступ к скрытым файлам
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Запрещаем листинг директорий
Options -Indexes

# === 5. РЕДИРЕКТЫ ===

# Главное зеркало (www → без www)
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_HOST} ^www\.ob-kub\.ru [NC]
    RewriteRule ^(.*)$ https://ob-kub.ru/$1 [R=301,L]
</IfModule>

# === 6. ОПТИМИЗАЦИЯ ЗАГОЛОВКОВ ===

# HSTS (защита от SSL Stripping)
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    
    # XSS Protection
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# === 7. ПРЕДЗАГРУЗКА КРИТИЧЕСКИХ РЕСУРСОВ ===

<IfModule mod_headers.c>
    # Предзагрузка основного CSS
    <FilesMatch "\.html$">
        Header set Link "</css/style-original.css>; rel=preload; as=style, </css/header.css>; rel=preload; as=style"
    </FilesMatch>
</IfModule>
